# Discord Bot
DISCORD_TOKEN=your_discord_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
ADMIN_GUILD_ID=your_guild_id_here
ADMIN_ROLE_ID=your_admin_role_id_here
# Required: long random string for dashboard sessions (e.g. `openssl rand -hex 32`)
DASHBOARD_SECRET=your_dashboard_secret_here
DASHBOARD_PORT=3000

# APIs
TMDB_API_KEY=your_tmdb_api_key_here
PLEX_TOKEN=your_plex_token_here
JELLYFIN_TOKEN=your_jellyfin_token_here

# Optional: Force the bot to always update a specific schedule message
SCHEDULE_MESSAGE_ID=your_schedule_message_id_here

# Optional: Default voice channel and event ID for /startevent
DEFAULT_VOICE_CHANNEL_ID=your_voice_channel_id_here
DEFAULT_EVENT_ID=your_event_id_here

# Optional: timezone for event times (default America/New_York)
EVENT_TIMEZONE=America/New_York

# Optional: Plex / Seerr / Radarr integrations (configured per server on the dashboard)
# Key used to encrypt saved integration secrets (defaults to DASHBOARD_SECRET; changing it means re-entering them)
INTEGRATIONS_KEY=
# Discord server IDs (comma-separated) allowed to use private/LAN addresses, e.g. your own server
INTEGRATIONS_PRIVATE_GUILDS=
# Public base URL of the dashboard, used to show webhook URLs (defaults to the URL you browse it at)
DASHBOARD_PUBLIC_URL=
