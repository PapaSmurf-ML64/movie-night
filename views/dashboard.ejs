<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movie Night Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/dashboard.css">
</head>
<body>
  <div class="container">
    <header class="hero">
      <div class="hero-top">
        <div class="hero-copy">
          <h1>Movie Night Dashboard</h1>
          <p>Now showing: your server schedule, archives, and attendance in one box-office view.</p>
        </div>
        <div class="hero-controls">
          <form method="get" action="/">
            <label for="guild_id">Active server</label>
            <select id="guild_id" name="guild_id" onchange="this.form.submit()">
              <% (guilds || []).forEach(g => { %>
                <option value="<%= g.id %>" <%= selectedGuildId === g.id ? 'selected' : '' %>><%= g.name %></option>
              <% }) %>
            </select>
          </form>
          <div class="hero-actions">
            <button class="theme-btn" id="themeToggleBtn" type="button" aria-pressed="false">Dark Mode</button>
            <button class="toggle-btn" id="toggleCommandsBtn" type="button" aria-expanded="false" aria-controls="commandsCollapse">Show Bot Commands</button>
          </div>
        </div>
      </div>
      <div class="commands-collapse" id="commandsCollapse" style="display:none;">
        <% if (botCommands && botCommands.length > 0) { %>
          <div class="commands-grid">
            <% botCommands.forEach(cmd => { %>
              <article class="command-card">
                <h3><%= cmd.name %></h3>
                <p><%= cmd.description %></p>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="empty-state">No command metadata available.</p>
        <% } %>
      </div>
    </header>

    <% // Hidden fields every form needs: which server, plus the CSRF token
       function formFields() { return `<input type="hidden" name="guild_id" value="${selectedGuildId}"><input type="hidden" name="_csrf" value="${csrfToken}">`; } %>
    <% if (flash) { %>
      <p class="flash <%= flash.type === 'error' ? 'flash-error' : '' %>" role="status"><%= flash.message %></p>
    <% } %>

    <section class="section">
      <div class="section-header">
        <h2>Add a Movie</h2>
      </div>
      <div class="section-body">
        <form class="add-form" id="searchForm">
          <div>
            <label for="searchTitle">Title</label>
            <input type="text" id="searchTitle" required placeholder="e.g. The Iron Giant">
          </div>
          <div>
            <label for="searchYear">Year (optional)</label>
            <input type="number" id="searchYear" min="1880" max="2100" placeholder="1999">
          </div>
          <div>
            <label for="addDate">Date (optional)</label>
            <input type="date" id="addDate" min="<%= today %>">
          </div>
          <button class="btn" type="submit">Search TMDB</button>
        </form>
        <p class="hint" style="margin-top:0.5rem;">Leave the date empty to use the next open <%= eventWeekdayName %>.</p>
        <div class="search-results" id="searchResults" aria-live="polite"></div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Upcoming Schedule <span class="muted">&middot; <time class="local-time" data-format="recurring" datetime="<%= eventTimeLabel.iso %>"><%= eventTimeLabel.fallback %></time></span></h2>
      </div>
      <div class="section-body">
        <% if (allDates && allDates.length > 0) { %>
          <div class="table-wrap">
            <table>
              <tr><th>Date</th><th>Movies</th></tr>
              <% allDates.forEach(dateStr => { %>
                <% const moviesForDate = dashboardByDate[dateStr] || []; %>
                <% const isRegularDay = new Date(dateStr + 'T00:00:00Z').getUTCDay() === eventWeekday; %>
                <tr>
                  <td>
                    <time class="local-time" data-format="full" datetime="<%= eventTimes[dateStr].iso %>"><%= eventTimes[dateStr].fallback %></time>
                    <% if (!isRegularDay) { %><span class="event-tag">Special Event</span><% } %>
                  </td>
                  <td>
                    <% if (moviesForDate.length === 0) { %>
                      <span class="muted">&lt;empty&gt;</span>
                    <% } %>
                    <% moviesForDate.forEach(m => { %>
                      <div class="movie-line">
                        <span class="movie-title">
                          <%= m.title %><% if (m.release_date) { %> (<%= m.release_date.slice(0,4) %>)<% } %>
                          <span class="muted">#<%= m.id %><% if (m.added_by) { %> &middot; added by <%= userMap[m.added_by] || m.added_by %><% } %></span>
                          <% const avail = availability[m.id]; if (avail) { %>
                            <span class="avail-badge avail-<%= avail.state %>" title="<%= avail.detail || avail.label %>"><%= avail.emoji %> <%= avail.label %></span>
                          <% } %>
                        </span>
                        <% if (avail && (avail.state === 'missing' || avail.state === 'error') && integrations.canRequest) { %>
                          <form class="action-form" action="/movies/<%= m.id %>/request" method="post">
                            <%- formFields() %>
                            <button class="btn" type="submit">Request</button>
                          </form>
                        <% } %>
                        <form class="action-form reschedule-form" action="/movies/<%= m.id %>/reschedule" method="post">
                          <%- formFields() %>
                          <input type="date" name="date" value="<%= m.date %>" min="<%= today %>" required aria-label="New date for <%= m.title %>">
                          <button class="btn btn-neutral" type="submit">Move</button>
                        </form>
                        <form class="action-form" action="/movies/<%= m.id %>/archive" method="post" onsubmit="return confirm('Archive <%= m.title.replace(/['\\]/g, '') %>?');">
                          <%- formFields() %>
                          <button class="btn btn-neutral" type="submit">Archive</button>
                        </form>
                        <form class="action-form" action="/movies/<%= m.id %>/delete" method="post" onsubmit="return confirm('Delete <%= m.title.replace(/['\\]/g, '') %>?');">
                          <%- formFields() %>
                          <button class="btn btn-danger" type="submit">Delete</button>
                        </form>
                      </div>
                    <% }) %>
                  </td>
                </tr>
              <% }) %>
            </table>
          </div>
        <% } else { %>
          <p class="empty-state">No movies scheduled.</p>
        <% } %>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Archived Events</h2>
      </div>
      <div class="section-body">
        <label for="archivedSearch">Filter archived titles</label>
        <input type="text" id="archivedSearch" placeholder="Search archived events..." onkeyup="filterArchivedEvents()">
        <% if (archived.length === 0) { %>
          <p class="empty-state">No archived events.</p>
        <% } else { %>
          <% // Group archived events by year %>
          <% const archivedByYear = {}; archived.forEach(e => { const y = Number(String(e.date).slice(0, 4)); if (!archivedByYear[y]) archivedByYear[y] = []; archivedByYear[y].push(e); }); %>
          <% Object.keys(archivedByYear).sort((a,b) => b-a).forEach(year => { %>
            <div class="archived-year-group">
              <button class="collapsible" onclick="toggleYear('<%= year %>')" data-year="<%= year %>">▶ <%= year %> (<%= archivedByYear[year].length %>)</button>
              <div id="archived-<%= year %>" class="archived-content" style="display:none;">
                <div class="table-wrap">
                  <table>
                    <tr><th>Title</th><th>Date Watched</th><th>Actions</th></tr>
                    <% archivedByYear[year].forEach(e => { %>
                      <tr class="archived-row">
                        <td><%= e.title %><% if (e.release_date) { %> (<%= e.release_date.slice(0,4) %>)<% } %></td>
                        <td><%= e.date %></td>
                        <td>
                          <form class="action-form" action="/movies/<%= e.id %>/delete" method="post" onsubmit="return confirm('Delete this archived event?');">
                            <%- formFields() %>
                            <button class="btn btn-danger" type="submit">Delete</button>
                          </form>
                        </td>
                      </tr>
                    <% }) %>
                  </table>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </section>

    <div class="split">
      <section class="section">
        <div class="section-header">
          <h2>RSVP List</h2>
        </div>
        <div class="section-body">
          <% if (rsvps.length === 0) { %>
            <p class="empty-state">No one has RSVP'd yet.</p>
          <% } else { %>
            <ul class="chips">
              <% rsvps.forEach(u => { %>
                <li>
                  <% if (userMap && userMap[u]) { %>
                    <%= userMap[u] %> (<%= u %>)
                  <% } else { %>
                    <%= u %>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </section>

      <section class="section">
        <div class="section-header">
          <h2>Attendance List<% if (attendanceDate) { %> &middot; <%= attendanceDate %><% } %></h2>
        </div>
        <div class="section-body">
          <% if (attendance.length === 0) { %>
            <p class="empty-state">No attendees yet.</p>
          <% } else { %>
            <ul class="chips">
              <% attendance.forEach(u => { %>
                <li>
                  <% if (userMap && userMap[u]) { %>
                    <%= userMap[u] %> (<%= u %>)
                  <% } else { %>
                    <%= u %>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </section>
    </div>

    <section class="section">
      <div class="section-header">
        <h2>Integrations</h2>
      </div>
      <div class="section-body">
        <p class="hint">Settings for this server only. Saved keys are encrypted and never shown again; leave a key field empty to keep the saved one. Clear a URL to remove that integration.</p>
        <form method="post" action="/integrations" id="integrationsForm">
          <%- formFields() %>

          <fieldset class="integration">
            <legend>Plex <% if (integrations.plex.connected) { %><span class="avail-badge avail-available">✅ <%= integrations.plex.serverName %></span><% } %></legend>
            <label for="plex_url">Server URL</label>
            <input type="text" id="plex_url" name="plex_url" value="<%= integrations.plex.url %>" placeholder="http://192.168.1.10:32400" autocomplete="off">
            <label for="plex_token">Plex token</label>
            <input type="password" id="plex_token" name="plex_token" placeholder="<%= integrations.plex.hasToken ? '•••••••• saved' : 'X-Plex-Token' %>" autocomplete="new-password">
            <button class="btn btn-neutral test-btn" type="button" data-kind="plex">Test</button>
            <span class="test-result" data-for="plex"></span>
          </fieldset>

          <fieldset class="integration">
            <legend>Overseerr / Jellyseerr</legend>
            <label for="seerr_url">URL</label>
            <input type="text" id="seerr_url" name="seerr_url" value="<%= integrations.seerr.url %>" placeholder="https://requests.example.com" autocomplete="off">
            <label for="seerr_key">API key</label>
            <input type="password" id="seerr_key" name="seerr_key" placeholder="<%= integrations.seerr.hasKey ? '•••••••• saved' : 'Settings → General → API Key' %>" autocomplete="new-password">
            <button class="btn btn-neutral test-btn" type="button" data-kind="seerr">Test</button>
            <span class="test-result" data-for="seerr"></span>
          </fieldset>

          <fieldset class="integration">
            <legend>Radarr <span class="muted">(used only if Seerr isn't set up)</span></legend>
            <label for="radarr_url">URL</label>
            <input type="text" id="radarr_url" name="radarr_url" value="<%= integrations.radarr.url %>" placeholder="http://192.168.1.10:7878" autocomplete="off">
            <label for="radarr_key">API key</label>
            <input type="password" id="radarr_key" name="radarr_key" placeholder="<%= integrations.radarr.hasKey ? '•••••••• saved' : 'Settings → General → API Key' %>" autocomplete="new-password">
            <div class="split-fields">
              <div>
                <label for="radarr_profile">Quality profile</label>
                <select id="radarr_profile" name="radarr_profile">
                  <option value="">(Test to load)</option>
                  <% if (integrations.radarr.qualityProfileId) { %><option value="<%= integrations.radarr.qualityProfileId %>" selected>Profile #<%= integrations.radarr.qualityProfileId %> (saved)</option><% } %>
                </select>
              </div>
              <div>
                <label for="radarr_root">Root folder</label>
                <select id="radarr_root" name="radarr_root">
                  <option value="">(Test to load)</option>
                  <% if (integrations.radarr.rootFolder) { %><option value="<%= integrations.radarr.rootFolder %>" selected><%= integrations.radarr.rootFolder %> (saved)</option><% } %>
                </select>
              </div>
            </div>
            <button class="btn btn-neutral test-btn" type="button" data-kind="radarr">Test</button>
            <span class="test-result" data-for="radarr"></span>
          </fieldset>

          <fieldset class="integration">
            <legend>Behavior</legend>
            <label class="check"><input type="checkbox" name="auto_request" <%= integrations.autoRequest ? 'checked' : '' %>> Automatically request movies that aren't on Plex when they're added</label>
            <label class="check"><input type="checkbox" name="vote_when_empty" <%= integrations.voteWhenEmpty ? 'checked' : '' %>> If nothing is scheduled on an event day, post a vote between 5 Plex movies 30 minutes before start (closes at start time)</label>
            <label for="vote_theme">Vote theme</label>
            <select id="vote_theme" name="vote_theme">
              <option value="month" <%= integrations.voteTheme !== 'season' ? 'selected' : '' %>>By month (e.g. October: Halloween, December: holidays)</option>
              <option value="season" <%= integrations.voteTheme === 'season' ? 'selected' : '' %>>By season (winter, spring, summer, fall)</option>
            </select>
          </fieldset>

          <fieldset class="integration">
            <legend>Playback webhooks</legend>
            <p class="hint">Posts "Now playing", counts attendance for members who ran <code>/linkplex</code>, and archives each movie when it's watched. Use one or both. Keep these URLs secret.</p>
            <label class="check"><input type="checkbox" name="plex_webhooks" <%= integrations.plexWebhooks ? 'checked' : '' %>> Plex webhooks <span class="muted">(Plex Pass: Plex settings → Webhooks → Add)</span></label>
            <input type="text" readonly value="<%= integrations.plexWebhookUrl %>" onclick="this.select()" aria-label="Plex webhook URL">
            <label class="check"><input type="checkbox" name="tautulli_webhooks" <%= integrations.tautulliWebhooks ? 'checked' : '' %>> Tautulli <span class="muted">(Settings → Notification Agents → Webhook, method POST, triggers: Playback Start/Resume and Watched)</span></label>
            <input type="text" readonly value="<%= integrations.tautulliWebhookUrl %>" onclick="this.select()" aria-label="Tautulli webhook URL">
            <details>
              <summary class="hint">Tautulli JSON body (paste into each trigger's Data tab)</summary>
              <pre class="code-block"><%= integrations.tautulliTemplate %></pre>
            </details>
          </fieldset>

          <button class="btn" type="submit">Save integrations</button>
        </form>
        <form method="post" action="/integrations/regenerate-webhook" class="action-form" style="margin-top:0.6rem;" onsubmit="return confirm('Generate new webhook URLs? The old ones stop working.');">
          <%- formFields() %>
          <button class="btn btn-danger" type="submit">Regenerate webhook URLs</button>
        </form>
      </div>
    </section>
  </div>

  <script>
    // ---- Show event times in the viewer's timezone, 12-hour clock ----
    (function localizeTimes() {
      var formats = {
        full: { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true, timeZoneName: 'short' },
        recurring: { weekday: 'long', hour: 'numeric', minute: '2-digit', hour12: true, timeZoneName: 'short' }
      };
      document.querySelectorAll('time.local-time').forEach(function(el) {
        var d = new Date(el.getAttribute('datetime'));
        if (isNaN(d)) return;
        var fmt = formats[el.dataset.format] || formats.full;
        try {
          var parts = new Intl.DateTimeFormat(undefined, fmt).formatToParts(d);
          var get = function(type) { var p = parts.find(function(x) { return x.type === type; }); return p ? p.value : ''; };
          var time = get('hour') + ':' + get('minute') + ' ' + get('dayPeriod').toUpperCase() + ' ' + get('timeZoneName');
          el.textContent = el.dataset.format === 'recurring'
            ? get('weekday') + 's at ' + time
            : get('weekday') + ', ' + get('month') + ' ' + get('day') + ', ' + get('year') + ' · ' + time;
          el.title = d.toString();
        } catch (e) { /* keep the server-rendered fallback */ }
      });
    })();

    // ---- Integrations: test a connection with the form's current values ----
    (function initIntegrationTests() {
      var form = document.getElementById('integrationsForm');
      if (!form) return;
      function fillSelect(select, items, current) {
        select.replaceChildren();
        items.forEach(function(it) {
          var opt = document.createElement('option');
          opt.value = it.value; opt.textContent = it.label; opt.selected = String(it.value) === String(current);
          select.appendChild(opt);
        });
      }
      form.querySelectorAll('.test-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var kind = btn.dataset.kind;
          var out = form.querySelector('.test-result[data-for="' + kind + '"]');
          out.textContent = 'Testing…'; out.className = 'test-result';
          var body = new URLSearchParams(new FormData(form));
          body.set('kind', kind);
          fetch('/api/integrations/test', { method: 'POST', credentials: 'same-origin', body: body })
            .then(function(r) { return r.json(); })
            .then(function(res) {
              if (!res.ok) { out.textContent = '✗ ' + res.error; out.className = 'test-result test-bad'; return; }
              var msg = '✓ Connected';
              if (kind === 'plex') msg += ' to ' + res.serverName + ' (' + res.libraries.join(', ') + ')';
              if (res.version) msg += ' (v' + res.version + ')';
              if (kind === 'radarr') {
                var prof = document.getElementById('radarr_profile'), root = document.getElementById('radarr_root');
                fillSelect(prof, res.qualityProfiles.map(function(p) { return { value: p.id, label: p.name }; }), prof.value || (res.qualityProfiles[0] || {}).id);
                fillSelect(root, res.rootFolders.map(function(f) { return { value: f, label: f }; }), root.value || res.rootFolders[0]);
                msg += '. Pick a profile and folder, then Save.';
              }
              out.textContent = msg; out.className = 'test-result test-ok';
            })
            .catch(function() { out.textContent = '✗ Test failed'; out.className = 'test-result test-bad'; });
        });
      });
    })();

    // ---- Add a movie: search TMDB, then post the chosen result ----
    (function initSearch() {
      var form = document.getElementById('searchForm');
      var out = document.getElementById('searchResults');
      if (!form || !out) return;
      var guildId = <%- JSON.stringify(selectedGuildId) %>;
      var csrf = <%- JSON.stringify(csrfToken) %>;

      function el(tag, props, children) {
        var node = document.createElement(tag);
        Object.keys(props || {}).forEach(function(k) { node[k] = props[k]; });
        (children || []).forEach(function(c) { node.appendChild(typeof c === 'string' ? document.createTextNode(c) : c); });
        return node;
      }
      function hidden(name, value) { return el('input', { type: 'hidden', name: name, value: value }); }
      function message(text) { out.replaceChildren(el('p', { className: 'empty-state' }, [text])); }

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var q = document.getElementById('searchTitle').value.trim();
        var year = document.getElementById('searchYear').value.trim();
        if (!q) return;
        message('Searching…');
        var url = '/api/search?guild_id=' + encodeURIComponent(guildId) + '&q=' + encodeURIComponent(q) + (year ? '&year=' + encodeURIComponent(year) : '');
        fetch(url, { credentials: 'same-origin' })
          .then(function(r) { return r.json().then(function(body) { if (!r.ok) throw new Error(body.error || 'Search failed'); return body; }); })
          .then(function(body) {
            if (!body.results.length) return message('No matches. Try a different title or year.');
            out.replaceChildren.apply(out, body.results.map(function(m) {
              var dateField = hidden('date', '');
              var add = el('form', { method: 'post', action: '/movies', className: 'action-form' }, [
                hidden('guild_id', guildId), hidden('_csrf', csrf), hidden('tmdb_id', m.id), dateField,
                el('button', { className: 'btn', type: 'submit' }, ['Add'])
              ]);
              // Use the date field's value at click time, not search time
              add.addEventListener('submit', function() { dateField.value = document.getElementById('addDate').value; });
              return el('div', { className: 'search-result' }, [
                el('span', {}, [m.title + (m.year ? ' (' + m.year + ')' : '')]),
                add
              ]);
            }));
          })
          .catch(function(err) { message(err.message); });
      });
    })();

    function toggleYear(year) {
      var content = document.getElementById('archived-' + year);
      var btn = document.querySelector('button[data-year="' + year + '"]');
      if (!content || !btn) return;
      if (content.style.display === 'none') {
        content.style.display = '';
        btn.textContent = '▼ ' + year + ' (' + content.querySelectorAll('.archived-row').length + ')';
      } else {
        content.style.display = 'none';
        btn.textContent = '▶ ' + year + ' (' + content.querySelectorAll('.archived-row').length + ')';
      }
    }

    function filterArchivedEvents() {
      var input = document.getElementById('archivedSearch').value.toLowerCase();
      var yearGroups = document.querySelectorAll('.archived-year-group');
      yearGroups.forEach(function(group) {
        var rows = group.querySelectorAll('.archived-row');
        var anyVisible = false;
        rows.forEach(function(row) {
          var title = row.children[0].textContent.toLowerCase();
          if (title.indexOf(input) > -1) {
            row.style.display = '';
            anyVisible = true;
          } else {
            row.style.display = 'none';
          }
        });
        group.style.display = anyVisible ? '' : 'none';
      });
    }

    function toggleCommands() {
      var panel = document.getElementById('commandsCollapse');
      var button = document.getElementById('toggleCommandsBtn');
      if (!panel || !button) return;
      var isHidden = panel.style.display === 'none';
      panel.style.display = isHidden ? '' : 'none';
      button.textContent = isHidden ? 'Hide Bot Commands' : 'Show Bot Commands';
      button.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    }

    (function initCommandsToggle() {
      var button = document.getElementById('toggleCommandsBtn');
      if (!button) return;
      button.addEventListener('click', toggleCommands);
    })();

    function setTheme(isDark) {
      var button = document.getElementById('themeToggleBtn');
      if (isDark) {
        document.body.classList.add('dark-theme');
        if (button) {
          button.textContent = 'Light Mode';
          button.setAttribute('aria-pressed', 'true');
        }
      } else {
        document.body.classList.remove('dark-theme');
        if (button) {
          button.textContent = 'Dark Mode';
          button.setAttribute('aria-pressed', 'false');
        }
      }
    }

    (function initThemeToggle() {
      var button = document.getElementById('themeToggleBtn');
      var saved = null;
      try { saved = localStorage.getItem('movieNightTheme'); } catch (e) {}
      setTheme(saved === 'dark');
      if (!button) return;
      button.addEventListener('click', function() {
        var nextIsDark = !document.body.classList.contains('dark-theme');
        setTheme(nextIsDark);
        try { localStorage.setItem('movieNightTheme', nextIsDark ? 'dark' : 'light'); } catch (e) {}
      });
    })();
  </script>
</body>
</html>
